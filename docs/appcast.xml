<?xml version="1.0" encoding="utf-8"?>
<!--
  Crema Sparkle appcast — placeholder.

  This file is REGENERATED in full by scripts/release.sh on every identity build
  (self-signed or Developer ID): the script runs Sparkle's generate_appcast over a
  staging folder holding only the new Crema-<version>.dmg, so the feed always carries
  exactly one item — the latest release. Update history lives in the GitHub Releases,
  not here.

  It is served at https://colatte.github.io/crema/appcast.xml — the SUFeedURL baked
  into the app's Info.plist — because GitHub Pages publishes this /docs folder from main.
  Publishing a new appcast is therefore a commit + push of this file to main; the release
  script writes it but never commits (see docs/internal/RELEASE-GUIDE.md).

  Until the first Sparkle-driven release regenerates it, the channel below is intentionally
  empty: no <item>, so a client that checks finds no update. Do not hand-author an item
  here — enclosures need an EdDSA signature that only generate_appcast (with the private key
  in the author's Keychain) can produce.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Crema</title>
    <link>https://colatte.github.io/crema/appcast.xml</link>
    <description>Updates for Crema.</description>
    <language>en</language>
  </channel>
</rss>
