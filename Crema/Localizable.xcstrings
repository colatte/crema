    "tour.step.finish.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema lives in the menu bar — its icon opens the menu, and Settings is there too, or press Command-Comma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema mora na barra de menus — o ícone dele abre o menu, e os Ajustes estão lá também, ou pressione ⌘ + vírgula."
          }
        }
      }
    },
