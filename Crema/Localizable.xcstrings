    "settings.hud.suppress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the system indicators"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir os indicadores do sistema"
          }
        }
      }
    },
    "settings.hud.suppress.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the system volume and brightness indicators and shows Crema’s instead."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta os indicadores de volume e brilho do sistema e mostra os do Crema."
          }
        }
      }
    },
    "settings.hud.suppress.footer.brightnessScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema only replaces the brightness indicator on the built-in display, while the pointer is on it. With the pointer on another display, macOS shows its own."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema só substitui o indicador de brilho na tela integrada, com o ponteiro sobre ela. Com o ponteiro em outra tela, quem mostra o indicador é o macOS."
          }
        }
      }
    },
    "settings.hud.suppress.needsPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs Accessibility access. Until then, macOS keeps showing its own indicators."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa da Acessibilidade. Até lá, o macOS continua mostrando os indicadores dele."
          }
        }
      }
    },
    "settings.hud.suppress.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System indicator replacement isn’t available on this Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A substituição dos indicadores do sistema não está disponível neste Mac."
          }
        }
      }
    },
    "settings.nowPlaying.browsers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include browser media"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir mídia de navegadores"
          }
        }
      }
    },
    "settings.nowPlaying.browsers.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes music playing in Safari, Chrome, and other browsers. This can make the player appear for videos that start playing on their own on websites."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui música tocando no Safari, Chrome e outros navegadores. Isso pode fazer o player aparecer em vídeos que começam a tocar sozinhos em sites."
          }
        }
      }
    },
    "settings.nowPlaying.controls": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show playback controls"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar controles de reprodução"
          }
        }
      }
    },
    "settings.nowPlaying.controls.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is off, the player shows only the cover, the title and the progress bar, with no play or skip buttons."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, o player mostra só a capa, o título e a barra de progresso, sem os botões de tocar e pular."
          }
        }
      }
    },
    "settings.nowPlaying.reactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the player automatically"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o player automaticamente"
          }
        }
      }
    },
    "settings.nowPlaying.reactive.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The player appears on its own when a track changes or playback starts. Turn this off to keep it hidden until you open it."
          }
