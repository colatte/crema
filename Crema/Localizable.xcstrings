    },
    "settings.general.style.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to every display. On a display without a notch, the Notch style falls back to Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todas as telas. Numa tela sem notch, o estilo Notch volta para o Cartão."
          }
        }
      }
    },
    "settings.hud.indicator": {
      "extractionState": "manual",
      "localizations": {
