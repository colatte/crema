            "value": "Slider"
          }
        }
      }
    },
    "settings.hud.suppress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the system indicators"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir os indicadores do sistema"
          }
        }
      }
    },
    "settings.hud.suppress.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the built-in volume and brightness HUDs and shows Crema's instead."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta os HUDs nativos de volume e brilho e mostra os do Crema."
          }
        }
      }
    },
    "settings.hud.suppress.needsPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires Accessibility access — grant it in the Permissions tab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer acesso de Acessibilidade — conceda na aba Permissões."
          }
        }
      }
    },
    "settings.nowPlaying.browsers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include browser media"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir mídia de navegadores"
          }
        }
      }
    },
    "settings.nowPlaying.browsers.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes music playing in Safari, Chrome, and other browsers. This can make the player appear for autoplay videos on websites."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui música tocando no Safari, Chrome e outros navegadores. Isso pode fazer o player aparecer em vídeos de reprodução automática em sites."
          }
        }
      }
    },
    "settings.nowPlaying.controls": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show playback controls"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar controles de reprodução"
          }
        }
      }
    },
    "settings.nowPlaying.controls.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off shows a view-only player — cover, title, and scrubber, without the transport buttons."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado, mostra um player só de visualização — capa, título e a barra de progresso, sem os botões."
          }
        }
      }
    },
    "settings.nowPlaying.reactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show on media events"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar em eventos de mídia"
          }
        }
      }
    },
    "settings.nowPlaying.reactive.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The player appears on its own when a track changes or playback starts. Turn off to keep it hidden until you open it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O player aparece sozinho quando a faixa troca ou a reprodução começa. Desative para mantê-lo oculto até você abrir."
          }
        }
      }
    },
    "settings.permissions.accessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessibilidade"
          }
        }
      }
    },
    "settings.permissions.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema needs Accessibility access to capture the media keys — for its volume and brightness HUDs and to replace the system indicators. Without it the app still runs; it just can't react to those keys. Granting is picked up automatically, no relaunch needed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema precisa do acesso de Acessibilidade para capturar as teclas de mídia — para os HUDs de volume e brilho e para substituir os indicadores do sistema. Sem ele o app continua funcionando; só não reage a essas teclas. A concessão é detectada automaticamente, sem precisar reiniciar."
          }
        }
      }
    },
    "settings.permissions.grant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
