    "menu.status.brightnessNoBuiltIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema can’t control screen brightness —\nit works only with the built-in display, and none is in use."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema não controla o brilho da tela —\nele funciona só com a tela integrada, e não há nenhuma em uso."
          }
        }
      }
    },
