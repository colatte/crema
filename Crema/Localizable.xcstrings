    "menu.accessibilityWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access is missing —\nCrema can’t react to the volume or brightness keys."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta o acesso de Acessibilidade —\no Crema não reage às teclas de volume e brilho."
          }
        }
      }
    },
    "menu.betterDisplay.drawing": {
      "extractionState": "manual",
