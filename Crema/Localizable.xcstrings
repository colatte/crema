    "tour.step.finish.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema lives in the menu bar, with no Dock icon. Its menu has Settings, and this tour if you want to see it again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema mora na barra de menus, sem ícone no Dock. O menu dele tem os Ajustes e este tour, se quiser rever."
          }
        }
      }
    },
    "tour.step.finish.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re set"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo pronto"
          }
        }
      }
    },
    "tour.step.more.filled.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of a thin line, the whole indicator fills up as the volume goes up. With the Card style."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de uma linha fina, o indicador inteiro se enche conforme o volume sobe. No estilo Card."
          }
        }
      }
    },
    "tour.step.more.filled.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bar that’s easier to see"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra mais fácil de ver"
          }
        }
      }
    },
    "tour.step.more.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change these, open Settings from the Crema icon in the menu bar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mudar isso, abra os Ajustes pelo ícone do Crema na barra de menus."
          }
        }
      }
    },
    "tour.step.more.output.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you change the volume, the indicator shows whether it’s playing through AirPods, headphones or an AirPlay speaker. This one’s automatic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você muda o volume, o indicador mostra se o som está saindo nos AirPods, nos fones ou num alto-falante AirPlay. Esse é automático."
          }
        }
      }
    },
    "tour.step.more.output.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where the sound is going"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja para onde vai o som"
          }
        }
      }
    },
    "tour.step.more.perDisplay.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With an external display connected, keep Notch on the built-in display and use Card on the other."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma tela externa conectada, deixe o Notch na tela integrada e use o Card na outra."
          }
        }
      }
    },
    "tour.step.more.perDisplay.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different style on each display"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um estilo diferente em cada tela"
          }
        }
      }
    },
    "tour.step.more.position.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bar you saw when you pressed the volume key can sit in a corner, on either side or at the bottom. With the Card style."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra que apareceu quando você apertou a tecla de volume pode ficar num canto, na lateral ou embaixo. No estilo Card."
          }
        }
      }
    },
