    "settings.permissions.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Accessibility, Crema notices the volume and brightness keys and can show its own indicators. Without it, the app still works, but it can’t notice those keys. No need to restart after you allow it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a Acessibilidade, o Crema percebe as teclas de volume e brilho e pode mostrar os próprios indicadores. Sem ela, o app continua funcionando, mas não percebe essas teclas. Não é preciso reiniciar depois de permitir."
          }
        }
      }
