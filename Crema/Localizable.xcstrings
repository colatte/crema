    "settings.hud.suppress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the system indicators"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir os indicadores do sistema"
          }
        }
      }
    },
    "settings.hud.suppress.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the system volume and brightness indicators and shows Crema’s instead."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta os indicadores de volume e brilho do sistema e mostra os do Crema."
          }
        }
      }
    },
    "settings.hud.suppress.footer.brightnessScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen brightness is replaced only on the built-in display, while the pointer is on it — a key aimed at any other display is left to the system."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brilho da tela é substituído só na tela integrada, enquanto o ponteiro está nela — uma tecla apontada para qualquer outra tela fica com o sistema."
          }
        }
      }
    },
    "settings.hud.suppress.needsPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs Accessibility access — until then the system’s own indicators stay."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa do acesso de Acessibilidade — até lá os indicadores do próprio sistema continuam."
          }
        }
      }
    },
    "settings.lockScreen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock Screen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela Bloqueada"
          }
        }
      }
    },
    "settings.lockScreen.artwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetch a larger cover"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar uma capa maior"
          }
        }
      }
    },
    "settings.lockScreen.artwork.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players hand over a small cover, which looks soft filling a screen. Crema can ask Apple’s public search for a larger one — no account, but it does send the track name. Off by default."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os players entregam uma capa pequena, que perde definição ao preencher a tela. O Crema pode pedir uma maior à busca pública da Apple — sem conta, mas envia o nome da faixa. Desativado por padrão."
          }
        }
      }
    },
    "settings.lockScreen.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of macOS doesn’t offer a way to draw on the lock screen, so Crema leaves it alone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do macOS não oferece um caminho para desenhar na tela bloqueada, então o Crema não mexe nela."
          }
        }
      }
    },
    "settings.lockScreen.widget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show what’s playing on the lock screen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o que está tocando na tela bloqueada"
          }
        }
      }
    },
    "settings.lockScreen.widget.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card above your login shows the cover, the title and the controls while music plays. Click it and the cover grows to fill the middle of the screen. It never asks for your password or reads anything you type."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão acima do seu login mostra a capa, o título e os controles enquanto a música toca. Clique nele e a capa cresce e ocupa o meio da tela. Ele nunca pede sua senha nem lê nada do que você digita."
          }
        }
      }
    },
    "settings.nowPlaying.browsers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include browser media"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir mídia de navegadores"
          }
        }
      }
    },
    "settings.nowPlaying.browsers.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes music playing in Safari, Chrome, and other browsers. This can make the player appear for autoplay videos on websites."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui música tocando no Safari, Chrome e outros navegadores. Isso pode fazer o player aparecer em vídeos de reprodução automática em sites."
          }
        }
      }
    },
    "settings.nowPlaying.controls": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show playback controls"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar controles de reprodução"
          }
        }
      }
    },
    "settings.nowPlaying.controls.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off shows a view-only player — cover, title, and scrubber, without the transport buttons."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, mostra um player só de visualização — capa, título e barra de progresso, sem os botões."
          }
        }
      }
    },
    "settings.nowPlaying.reactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the player automatically"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o player automaticamente"
          }
        }
      }
    },
    "settings.nowPlaying.reactive.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The player appears on its own when a track changes or playback starts. Turn off to keep it hidden until you open it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O player aparece sozinho quando a faixa troca ou a reprodução começa. Desative para mantê-lo oculto até você abri-lo."
          }
        }
      }
    },
    "settings.permissions.accessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessibilidade"
          }
        }
      }
    },
    "settings.permissions.accessibility.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigatória"
          }
        }
      }
    },
    "settings.permissions.automation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automação"
          }
        }
      }
    },
    "settings.permissions.automation.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off in System Settings. Now Playing still works through the usual reader."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativada nos Ajustes do Sistema. O Tocando Agora continua funcionando pelo leitor principal."
          }
        }
      }
    },
    "settings.permissions.automation.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Crema’s backup reader needs this — it asks %@ what is playing. The usual reader needs no permission, so Now Playing works either way."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o leitor reserva do Crema precisa disso — ele pergunta ao %@ o que está tocando. O leitor principal não precisa de permissão nenhuma, então o Tocando Agora funciona de qualquer forma."
          }
        }
      }
    },
    "settings.permissions.automation.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional"
          }
        }
      }
    },
    "settings.permissions.automation.noAppOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No music app open"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app de música aberto"
          }
        }
      }
    },
    "settings.permissions.automation.noTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS only answers about an app that is open — open %@ to check."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS só responde sobre um app que esteja aberto — abra %@ para verificar."
          }
        }
      }
    },
    "settings.permissions.automation.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Automation Settings…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes de Automação…"
          }
        }
      }
    },
    "settings.permissions.automation.request": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request Automation Access…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitar acesso de Automação…"
          }
        }
      }
    },
    "settings.permissions.automation.undecided": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hasn’t asked you about this yet. Request it and macOS shows its own dialog."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS ainda não perguntou nada sobre isso. Solicite e o próprio macOS mostra o diálogo."
          }
        }
      }
    },
    "settings.permissions.automation.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS didn’t answer. Crema checks again while this tab is open."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não respondeu. O Crema verifica de novo enquanto esta aba estiver aberta."
          }
        }
      }
    },
    "settings.permissions.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando…"
          }
        }
      }
    },
    "settings.permissions.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema needs Accessibility access to capture the media keys — for its volume and brightness indicators and to replace the system’s. Without it the app still runs; it just can’t react to those keys. Granting is picked up automatically, no relaunch needed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema precisa do acesso de Acessibilidade para capturar as teclas de mídia — para os indicadores de volume e brilho e para substituir os do sistema. Sem ele o app continua funcionando; só não reage a essas teclas. A concessão é detectada automaticamente, sem precisar reiniciar."
          }
        }
      }
    },
    "settings.permissions.grant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Accessibility Access…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceder acesso de Acessibilidade…"
          }
        }
      }
    },
    "settings.permissions.granted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedida"
          }
        }
      }
    },
    "settings.permissions.notGranted": {
      "extractionState": "manual",
