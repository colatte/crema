    "tour.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema shows what’s playing near the top of your screen and can replace the system’s volume and brightness indicators with its own."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema mostra o que está tocando perto do topo da tela e pode substituir os indicadores de volume e brilho do sistema pelos dele."
          }
        }
      }
    },
