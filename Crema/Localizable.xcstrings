    },
    "settings.permissions.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema needs Accessibility to notice the volume and brightness keys and show its own indicators. Without it the app still works; it just doesn’t react to those keys. No need to relaunch after you allow it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema precisa da Acessibilidade para perceber as teclas de volume e brilho e mostrar os indicadores dele. Sem ela o app funciona, só não reage a essas teclas. Não é preciso reiniciar depois de permitir."
          }
        }
      }
    },
