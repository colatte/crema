    "settings.hud.suppress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the system indicators"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir os indicadores do sistema"
          }
        }
      }
    },
    "settings.hud.suppress.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the system volume and brightness indicators and shows Crema’s instead."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta os indicadores de volume e brilho do sistema e mostra os do Crema."
          }
        }
      }
    },
    "settings.hud.suppress.footer.brightnessScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightness is only replaced on the built-in display, while the pointer is on it. With the pointer on another display, macOS shows its own."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brilho só é substituído na tela integrada, com o ponteiro sobre ela. Com o ponteiro em outra tela, quem mostra é o macOS."
          }
        }
      }
    },
    "settings.hud.suppress.needsPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs Accessibility access. Until then, macOS keeps showing its own indicators."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa da Acessibilidade. Até lá, o macOS continua mostrando os indicadores dele."
          }
        }
      }
    },
    "settings.hud.suppress.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System indicator replacement isn’t available on this Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A substituição dos indicadores do sistema não está disponível neste Mac."
          }
        }
      }
    },
    "settings.nowPlaying.browsers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include browser media"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir mídia de navegadores"
          }
        }
      }
    },
    "settings.nowPlaying.browsers.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes music playing in Safari, Chrome, and other browsers. This can make the player appear for autoplay videos on websites."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui música tocando no Safari, Chrome e outros navegadores. Isso pode fazer o player aparecer em vídeos de reprodução automática em sites."
          }
        }
      }
    },
    "settings.nowPlaying.controls": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show playback controls"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar controles de reprodução"
          }
        }
      }
    },
    "settings.nowPlaying.controls.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is off, the player shows only the cover, the title and the progress bar, with no play or skip buttons."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, o player mostra só a capa, o título e a barra de progresso, sem os botões de tocar e pular."
          }
        }
      }
    },
    "settings.nowPlaying.reactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the player automatically"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o player automaticamente"
          }
        }
      }
    },
    "settings.nowPlaying.reactive.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The player appears on its own when a track changes or playback starts. Turn off to keep it hidden until you open it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O player aparece sozinho quando a faixa troca ou a reprodução começa. Desative para mantê-lo oculto até você abri-lo."
          }
        }
      }
    },
    "settings.nowPlaying.source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading what’s playing"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitura do que está tocando"
          }
        }
      }
    },
    "settings.nowPlaying.source.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema asks macOS what’s playing. With no answer, the player stays hidden and the options below have no effect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema pergunta ao macOS o que está tocando. Sem resposta, o player fica escondido e as opções abaixo não fazem efeito."
          }
        }
      }
    },
    "settings.nowPlaying.source.notReporting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem resposta"
          }
        }
      }
    },
    "settings.nowPlaying.source.reporting": {
      "extractionState": "manual",
      "localizations": {
