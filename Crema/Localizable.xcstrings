    "settings.hud.betterDisplay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BetterDisplay integration"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Integração com o BetterDisplay"
          }
        }
      }
    },
    "settings.hud.betterDisplay.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With BetterDisplay 4.2.1 or newer, Crema can show the brightness indicator for an external display. Nothing to enable here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o BetterDisplay 4.2.1 ou posterior, o Crema pode mostrar o indicador de brilho de uma tela externa. Não é preciso ativar nada aqui."
          }
        }
      }
    },
    "settings.hud.betterDisplay.handoff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Crema replaces the system indicators, it sets up BetterDisplay for you: it turns on “Dispatch OSD notifications” and turns off BetterDisplay’s own indicator. When you quit Crema, everything goes back to how it was."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o Crema substitui os indicadores do sistema, ele configura o BetterDisplay por você: ativa “Dispatch OSD notifications” e desativa o indicador do próprio BetterDisplay. Quando você encerra o Crema, tudo volta a ser como era."
          }
        }
      }
    },
    "settings.hud.betterDisplay.howTo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In BetterDisplay, go to Settings → Application → Integration and turn on “Dispatch OSD notifications”. Then, in Settings → Keyboard → OSD, turn off “Show brightness, volume, mute OSD” so only Crema’s indicator appears."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No BetterDisplay, vá em Settings → Application → Integration e ative “Dispatch OSD notifications”. Depois, em Settings → Keyboard → OSD, desative “Show brightness, volume, mute OSD” para que só o indicador do Crema apareça."
          }
        }
      }
    },
    "settings.hud.betterDisplay.notReceiving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No signal"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem sinal"
          }
        }
      }
    },
    "settings.hud.betterDisplay.receiving": {
