    "onboarding.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema uses the Accessibility permission to capture the volume and brightness keys so it can show its own HUD. Without it the app keeps working — it just can't react to those keys."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema usa a permissão de Acessibilidade para capturar as teclas de volume e brilho e mostrar o próprio HUD. Sem ela o app continua funcionando — só não reage a essas teclas."
          }
        }
      }
    },
    "onboarding.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluir"
          }
        }
      }
    },
    "onboarding.grantDetection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granting is picked up automatically — no relaunch needed. If capture still doesn't start, relaunch Crema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A concessão é detectada automaticamente — sem precisar reiniciar. Se a captura não começar, reinicie o Crema."
          }
        }
      }
    },
    "onboarding.notNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora não"
          }
        }
      }
    },
    "onboarding.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes do Sistema…"
          }
        }
      }
    },
    "onboarding.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema needs Accessibility access"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema precisa de acesso de Acessibilidade"
          }
        }
      }
    },
    "settings.general.launchAtLogin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Crema at login"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o Crema ao iniciar sessão"
          }
        }
      }
    },
    "settings.general.launchAtLogin.needsApproval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve Crema in System Settings › General › Login Items to finish enabling this."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove o Crema em Ajustes do Sistema › Geral › Itens de Início de Sessão para concluir a ativação."
          }
        }
      }
    },
    "settings.general.style": {
      "extractionState": "manual",
