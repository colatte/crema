    "onboarding.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crema uses the Accessibility permission to capture the volume and brightness keys so it can show its own indicators. Without it the app keeps working — it just can’t react to those keys."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema usa a permissão de Acessibilidade para capturar as teclas de volume e brilho e mostrar os próprios indicadores. Sem ela o app continua funcionando — só não reage a essas teclas."
          }
        }
      }
    },
    "onboarding.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
