    "settings.hud.betterDisplay.unanswered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BetterDisplay isn’t responding to Crema. In BetterDisplay, go to Settings → Application → Integration and turn on “Enable CLI access and notification based integration”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O BetterDisplay não está respondendo ao Crema. No BetterDisplay, vá em Settings → Application → Integration e ative “Enable CLI access and notification based integration”."
          }
        }
      }
