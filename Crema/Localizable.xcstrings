          "stringUnit": {
            "state": "translated",
            "value": "Crema only uses this when its usual way of seeing what’s playing fails; then it asks %@ directly. Without it, the player keeps working."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Crema só usa isto quando o jeito normal de ver o que está tocando falha. Nesse caso, ele pergunta direto ao %@. Sem essa permissão, o player continua funcionando."
          }
        }
