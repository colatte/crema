        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluir"
          }
        }
      }
    },
    "onboarding.grantDetection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granting is picked up automatically — no relaunch needed. If capture still doesn’t start, relaunch Crema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A concessão é detectada automaticamente — sem precisar reiniciar. Se mesmo assim a captura não começar, reinicie o Crema."
          }
        }
      }
    },
