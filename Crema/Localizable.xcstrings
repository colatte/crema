    },
    "settings.general.style.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to every display. On a display without a notch, the Notch style falls back to Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todas as telas. Numa tela sem notch, o estilo Notch volta para o Card."
          }
        }
      }
    },
    "settings.general.style.footer.fallingBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to every display. No connected display has a notch, so every one is drawing Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todas as telas. Nenhuma tela conectada tem notch, então todas mostram o Card."
          }
        }
      }
    },
    "settings.general.style.footer.replacesPerDisplay": {
