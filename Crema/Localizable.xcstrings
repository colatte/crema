    },
    "settings.permissions.automation.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Crema only uses this when its usual way of seeing what’s playing fails: then it asks %@ directly. Without it, the player keeps working."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. O Crema só usa isto quando o jeito normal de ver o que toca falha: aí ele pergunta direto a %@. Sem a permissão, o player continua funcionando."
          }
        }
      }
    },
    "settings.permissions.automation.header": {
