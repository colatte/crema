          "stringUnit": {
            "state": "translated",
            "value": "With BetterDisplay 4.2.1 or newer, Crema can show the brightness indicator for an external display. Nothing to enable here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o BetterDisplay 4.2.1 ou posterior, o Crema pode mostrar o indicador de brilho de uma tela externa. Não é preciso ativar nada aqui."
          }
        }
      }
    },
    "settings.hud.betterDisplay.howTo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In BetterDisplay, turn on Settings → Application → Integration → OSD notification. In that same panel, turn off BetterDisplay’s own brightness indicator (OSD)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No BetterDisplay, ative Settings → Application → Integration → OSD notification. Nesse mesmo painel, desative o indicador de brilho do próprio BetterDisplay (OSD)."
          }
        }
      }
    },
