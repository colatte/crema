<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Deliberately empty, for the Developer ID path (release.sh): there Crema needs no runtime
  exceptions (strongest notarization posture). The self-signed build carries the hardened runtime
  too, with one exception kept in Crema-SelfSigned.entitlements: library validation off, because a
  self-signed certificate has no Team ID (docs/DECISIONS.md: self-signed-runtime-without-library-validation).
  disable-library-validation: not needed on the Developer ID path — the brightness dlopens are Apple-signed system frameworks (DisplayServices, CoreBrightness); library validation allows Apple code.
  allow-dyld-environment-variables: not needed — dlopen by absolute path, no DYLD_* set.
  allow-jit / allow-unsigned-executable-memory: not needed — no JIT, no writable-executable memory.
  automation.apple-events: not needed — the osascript subprocess sends the events, not Crema.
  app-sandbox: deliberately unsandboxed — needs the Accessibility event tap and private brightness frameworks.
  get-task-allow: must stay absent — notarization rejects it.
  If a future change loads a non-Apple library in-process, sends Apple events in-process, or adds JIT, add only that one entitlement.
-->
<plist version="1.0">
<dict/>
</plist>
